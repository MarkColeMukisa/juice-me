{
    "$schema": "https://nevela.dev/schema/resource.v1.json",
    "name": "Order",
    "table": "orders",
    "slug": "orders",
    "label": "Order",
    "pluralLabel": "Orders",
    "icon": "shopping-bag",
    "items": "OrderItem",
    "owner": "email",
    "fields": {
        "number": {
            "kind": "string",
            "auto": "JM",
            "unique": true
        },
        "customer": {
            "kind": "string",
            "label": "Your name"
        },
        "email": {
            "kind": "string",
            "format": "email"
        },
        "phone": {
            "kind": "string",
            "format": "tel",
            "required": false,
            "label": "Phone number",
            "country": "UG"
        },
        "delivery": {
            "kind": "enum",
            "options": [
                "collection",
                "delivery"
            ],
            "default": "collection",
            "label": "How you get it",
            "optionLabels": {
                "collection": "I'll collect it at the bar",
                "delivery": "Deliver it to me on campus"
            }
        },
        "details": {
            "kind": "text",
            "label": "Where to deliver",
            "when": {
                "delivery": [
                    "delivery"
                ]
            }
        },
        "status": {
            "kind": "enum",
            "options": [
                "pending",
                "accepted",
                "preparing",
                "ready",
                "completed",
                "cancelled"
            ],
            "default": "pending"
        },
        "total": {
            "kind": "float",
            "format": "money",
            "required": false
        }
    },
    "fixed": true,
    "actions": {
        "accept": {
            "label": "Accept",
            "icon": "check",
            "when": {
                "status": "pending"
            },
            "set": {
                "status": "accepted"
            }
        },
        "startPreparing": {
            "label": "Start preparing",
            "icon": "cup-soda",
            "when": {
                "status": "accepted"
            },
            "set": {
                "status": "preparing"
            }
        },
        "markReady": {
            "label": "Ready",
            "icon": "bell",
            "when": {
                "status": "preparing"
            },
            "set": {
                "status": "ready"
            }
        },
        "complete": {
            "label": "Complete",
            "icon": "check-check",
            "when": {
                "status": "ready"
            },
            "set": {
                "status": "completed"
            }
        },
        "cancel": {
            "label": "Cancel order",
            "icon": "x",
            "confirm": "Cancel this order?",
            "when": {
                "status": [
                    "pending",
                    "accepted",
                    "preparing",
                    "ready"
                ]
            },
            "set": {
                "status": "cancelled"
            },
            "fields": {
                "reason": {
                    "kind": "text",
                    "required": false
                }
            }
        },
        "callOff": {
            "label": "Cancel with a reason",
            "icon": "ban",
            "when": {
                "status": [
                    "pending",
                    "accepted",
                    "preparing",
                    "ready"
                ]
            },
            "set": {
                "status": "cancelled"
            },
            "fields": {
                "reason": {
                    "kind": "text"
                }
            }
        }
    }
}
